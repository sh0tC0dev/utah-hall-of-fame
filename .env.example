# Server only. Never commit real values or use NEXT_PUBLIC_ for credentials.
REVIEW_ENABLED=
REVIEW_SITE_ID=
REVIEW_SITE_NAME=
REVIEW_REPOSITORY=
REVIEW_SITE_URL=
REVIEW_STORAGE_NAMESPACE=
# The site's reviewer list: comma separated addresses, each of which requests
# and receives its own PIN, and is named on the batches it sends.
REVIEW_ACCESS_EMAILS=
REVIEW_OWNER_EMAIL=
REVIEW_INTAKE_EMAIL=
REVIEW_FROM_EMAIL=
# Generate a different random secret per client and environment (openssl rand -hex 32).
REVIEW_SECRET=
RESEND_API_KEY=
# A dedicated PRIVATE Vercel Blob store per client; use isolated preview storage too.
BLOB_READ_WRITE_TOKEN=
# Set to actual deployed Git revision/source fingerprint in CI.
REVIEW_SOURCE_VERSION=
# Only on Cloud Run behind a direct domain mapping with no load balancer:
# google-front-end. Leave unset on Vercel. Any other value refuses every request.
REVIEW_TRUSTED_PROXY=
